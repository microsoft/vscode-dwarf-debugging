+// Parse an Itanium type_info::name() mangled type name (e.g. "7Derived" or
+// "N3foo7DerivedE") into a qualified source name ("Derived", "foo::Derived").
+// Handles the unqualified and nested-name cases; returns empty for forms we
+// don't resolve here (templates, etc.).
+static std::string DemangleTypeInfoName(llvm::StringRef s) {
+  auto is_digit = [](char c) { return c >= '0' && c <= '9'; };
+  auto read_part = [&](llvm::StringRef& r) -> std::string {
+    size_t i = 0;
+    while (i < r.size() && is_digit(r[i])) {
+      ++i;
+    }
+    if (i == 0) {
+      return {};
+    }
+    unsigned len = 0;
+    if (r.substr(0, i).getAsInteger(10, len)) {
+      return {};
+    }
+    r = r.substr(i);
+    if (len == 0 || len > r.size()) {
+      return {};
+    }
+    std::string part = r.substr(0, len).str();
+    r = r.substr(len);
+    return part;
+  };
+  if (s.empty()) {
+    return {};
+  }
+  if (s.front() == 'N') {  // nested-name: N <part>+ E
+    s = s.drop_front();
+    std::string out;
+    while (!s.empty() && s.front() != 'E') {
+      std::string part = read_part(s);
+      if (part.empty()) {
+        return {};
+      }
+      if (!out.empty()) {
+        out += "::";
+      }
+      out += part;
+    }
+    return out;
+  }
+  if (is_digit(s.front())) {  // plain unqualified name
+    std::string part = read_part(s);
+    return s.empty() ? part : std::string{};
+  }
+  return {};
+}
